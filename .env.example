# Production environment template — copy to .env and fill in real values.
# NEVER commit real credentials.

NODE_ENV=production

# Public site URL (no trailing slash). Also sets SEO metadataBase (og:image,
# canonical links) — if left unset that silently falls back to a placeholder
# domain baked into app/layout.js, so always set this for a real deployment.
APP_URL=https://pos.example.com
NEXT_PUBLIC_SITE_URL=https://pos.example.com

# cPanel injects PORT; do not hardcode in production
# PORT=3000
HOSTNAME=0.0.0.0

# PostgreSQL (URL-encode special characters in password)
# Example: postgresql://user:p%40ss@localhost:5432/pos_db
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# Pool / SSL (local cPanel Postgres usually needs no SSL)
PG_POOL_MAX=5
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=10000
PGSSL=false
# PGSSL_REJECT_UNAUTHORIZED=true

# Sessions are opaque random tokens verified against the `sessions` table
# (never decoded/trusted client-side) and CSRF uses the double-submit-cookie
# pattern — neither currently needs a server secret to be secure. Set these
# anyway (harmless, reserved for future HMAC signing) — do not rely on them.
SESSION_SECRET=change-me-to-a-long-random-string
CSRF_SECRET=change-me-to-another-long-random-string
FORCE_SECURE_COOKIES=1

# Uploads — persistent path outside release folders when possible
UPLOADS_DIR=./uploads
IMAGES_PATH=/uploads

# Logging
LOG_LEVEL=info

# Rate limits (per IP per minute)
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PUBLIC=8

# Business identity. The values that print on receipts live in the
# system_settings table (Admin -> Settings); this is only the fallback used by
# npm run db:seed when seeding a brand-new database.
RESTAURANT_NAME=Sundar Bagaicha Events

# First admin seed (used only by npm run db:seed)
ADMIN_USERNAME=admin
# Must be at least 8 characters (scripts/seed-postgres.mjs enforces this).
# Never put a real credential in this template — it is committed to the repo.
ADMIN_PASSWORD=ChangeMeNow123!
ADMIN_FULL_NAME=Restaurant Admin

# Deployment mode — see lib/deployment.js
# FULL_SERVICE (default): admin+waiter+kitchen+cashier, floor/KOT/kitchen-display on.
# COUNTER_READY_SERVE: single admin role, counter/ready-to-serve only.
RESTAURANT_MODE=FULL_SERVICE
# admin is always enabled regardless of this list.
POS_ENABLED_ROLES=admin,waiter,kitchen,cashier
